{
 "doctype": "DocType",
 "name": "FB Inventory Count Task",
 "module": "KoPOS",
 "document_type": "Document",
 "engine": "InnoDB",
 "autoname": "format:INV-COUNT-{YYYY}-{#####}",
 "is_submittable": 0,
